# Configuración de nginx para servir la SPA y hacer de puerta de entrada al backend.
#
# Decisión central: nginx es el ÚNICO servicio publicado. El navegador habla sólo con él,
# y todo lo que empieza con /api lo reenvía al backend. Consecuencias:
#
#   - El frontend no necesita CORS: para el navegador es el mismo origen.
#   - La imagen del frontend no lleva ninguna URL adentro, así que la misma imagen
#     sirve en cualquier entorno.
#
# ── Por qué esto es una PLANTILLA y no un nginx.conf (TP6) ──────────────────
#
# Hasta el TP5 la dirección del backend estaba escrita acá adentro: "http://backend:8080",
# el nombre del servicio en el compose. Eso alcanzaba mientras el único destino fuera
# Docker Compose, donde ese nombre lo resuelve el DNS interno.
#
# En un entorno de verdad ese nombre no existe: el backend es una URL, y es DISTINTA en
# QA y en producción. Si la dirección queda horneada en la imagen, la imagen de QA no
# sirve para producción — y entonces "se despliega lo mismo que se probó" es imposible.
#
# La salida es que nginx la lea DEL ENTORNO al arrancar. La imagen oficial de nginx
# procesa los archivos de /etc/nginx/templates/ y reemplaza ${VARIABLE} por su valor
# antes de levantar. Por eso este archivo termina en .template y vive en esa carpeta:
# puesto en conf.d/ nginx lo leería tal cual, con los ${...} sin reemplazar, y no
# arrancaría.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # No revelar la versión de nginx en las respuestas de error.
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Quién resuelve los nombres. En compose es el DNS interno de Docker (127.0.0.11),
    # que traduce "backend" al contenedor; en un proveedor de nube es un DNS público,
    # que traduce el host de la api.
    #
    # Hace falta declararlo porque abajo el destino del proxy es una VARIABLE: cuando
    # nginx no conoce el destino al arrancar, resuelve el nombre mientras corre, y para
    # eso necesita saber a quién preguntarle. Sin esta línea no levanta.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # La dirección del backend, leída del entorno. Se guarda en una variable y no se
    # escribe directo en proxy_pass para que nginx no intente resolverla al arrancar:
    # si el backend todavía no está disponible, con el nombre literal nginx se niega a
    # levantar; con una variable arranca igual y resuelve en cada pedido.
    set $destino_api ${BACKEND_URL};

    # Vite le pone un hash al nombre de cada asset (index-ByeSMMTX.js), así que el
    # contenido de una URL nunca cambia: se puede cachear para siempre.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html es la excepción: es el que apunta a los assets nuevos después de un
    # deploy. Si se cacheara, el navegador seguiría pidiendo los assets viejos.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Todo /api va al backend.
    #
    # Cuando proxy_pass lleva una variable, nginx NO reemplaza la parte de la URI que
    # coincidió con el location: pasa la ruta completa tal como llegó. O sea que
    # /api/stock sale como <destino>/api/stock, que es justo lo que el backend espera.
    # Por eso acá no va el "/api/" al final que llevaba la versión con nombre fijo.
    location /api/ {
        proxy_pass $destino_api;
        proxy_http_version 1.1;

        # Sin esto, al hablar con una api por HTTPS el handshake no informa a qué host
        # va dirigido, y el servidor del otro lado no sabe qué certificado presentar.
        # En compose, que es HTTP, no molesta.
        proxy_ssl_server_name on;

        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        # Más generoso que los 30s del TP2: en un plan gratuito el backend puede estar
        # dormido, y el primer pedido lo despierta. Un timeout corto corta justo ahí.
        proxy_read_timeout    75s;
    }

    # Estado del backend, accesible desde afuera para diagnóstico y para el smoke test.
    location = /health {
        proxy_pass $destino_api;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_connect_timeout 10s;
        proxy_read_timeout    75s;
        access_log off;
    }

    # Estado de nginx mismo, para su propio healthcheck en el compose. No toca el backend:
    # responde aunque la api esté caída, que es justamente para lo que sirve.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # React Router maneja las rutas en el cliente: /stock y /catalogo no existen como
    # archivos. Sin este try_files, recargar la página en /stock daría un 404 de nginx.
    # Va al final porque "location /" es el menos específico.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
