# dependencias y artefactos de build
node_modules/
bin/
obj/
dist/
build/

# secretos: NUNCA se versionan
.env
*.local

# basura del sistema operativo y del editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- .NET (TP2: la app del semestre) ----
**/TestResults/

# Reportes de cobertura: se generan en cada corrida y viajan como artefacto del
# pipeline, no en el repositorio.
**/coverage/
**/coveragereport/
**/frontend-coverage/
.vs/
*.user
*.suo

# Reportes y resultados de Playwright: se generan en cada corrida y viajan como artefacto.
playwright-report/
test-results/

# ---- Vite / TypeScript ----
*.tsbuildinfo
.vite/

# ---- Terraform (TP8) ----
# El estado guarda en texto plano todo lo que Terraform sabe de la infraestructura,
# contraseñas incluidas. Vive sólo en la máquina del que aplica y no se versiona nunca.
*.tfstate
*.tfstate.*
.terraform/
# Valores locales que no se publican.
*.tfvars
# Un plan guardado con -out también lleva los valores sensibles adentro.
*.tfplan

# ---- Herramientas ----
.claude/settings.local.json
