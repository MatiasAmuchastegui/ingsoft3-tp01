# Plantilla de configuración del docker-compose.
#
#   cp .env.example .env
#   docker compose up -d
#
# Los valores de acá FUNCIONAN tal como están, para que clonar el repo y levantarlo
# sean dos pasos y nada más. Son de desarrollo: si esto fuera a un servidor de verdad,
# hay que cambiar POSTGRES_PASSWORD, JWT_KEY y las dos contraseñas del seed.
#
# Este archivo SÍ se commitea. El .env que sale de copiarlo NO: está en .gitignore.

# ---------- Base de datos ----------
POSTGRES_DB=joyeria
POSTGRES_USER=joyeria
POSTGRES_PASSWORD=joyeria_dev_cambiar

# ---------- Backend ----------
# Clave de firma de los tokens. Mínimo 32 bytes: si es más corta, la API no arranca
# y lo dice en el log (fallar al arrancar es mejor que fallar en el primer login).
JWT_KEY=clave-de-desarrollo-cambiar-en-produccion-32bytes-minimo
JWT_MINUTOS_DE_VIDA=480

# Usuario administrador que crea el seed la primera vez que arranca con la base vacía.
# Al instalarlo en la computadora de la joyería, acá va el mail y la contraseña del dueño:
# todavía no hay ABM de usuarios, así que este es el único camino para el primer usuario.
SEED_EMAIL_ADMIN=admin@joyeria.local
SEED_NOMBRE_ADMIN=Administradora
SEED_PASSWORD_ADMIN=Admin123!

# Contraseña de los vendedores de ejemplo.
SEED_PASSWORD_VENDEDOR=Vendedor123!

# ---------- Puertos publicados en el host ----------
# Único puerto expuesto: nginx. El backend y la base quedan en la red interna.
PUERTO_FRONTEND=8080

# ---------- Imágenes publicadas (sólo para docker-compose.registry.yml) ----------
# Cambiar el usuario/repo por el propio antes de publicar.
IMAGE_PREFIX=ghcr.io/matiasamuchastegui/ingsoft3-tp01
IMAGE_TAG=1.0.0
